{
  "name": "reporta-desktop-user",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "gh.gov.reporta.user",
    "productName": "REPORTA User",
    "directories": {
      "output": "C:/Users/HP/Documents/DATILA/REPORTA/reporta/release/windows/user"
    },
    "files": [
      "main.js",
      "www/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "REPORTA User"
    }
  },
  "allowScripts": {}
}
